{
  "mcpServers": {
    "rag-knowledge": {
      "command": "rag-mcp-server",
      "env": {
        "RAG_MCP_BACKEND": "mock",
        "RAG_MCP_KNOWLEDGE_DIR": "/opt/go/src/github.com/bogdando/opendev-agents/knowledge",
        "RAG_MCP_TIERED_RETRIEVAL": "false",
        "RAG_MCP_SUMMARIZER_URL": "http://127.0.0.1:11434",
        "RAG_MCP_SUMMARIZER_MODEL": "qwen2.5:7b",
        "RAG_MCP_SUMMARIZER_TIMEOUT": "180",
        "RAG_MCP_PNG_WRAP": "true",
        "RAG_MCP_PNG_MAX_PAGES": "${RAG_MCP_PNG_MAX_PAGES}",
        "RAG_MCP_PNG_MAX_CHARS_PER_STORE": "${RAG_MCP_PNG_MAX_CHARS_PER_STORE}",
        "RAG_MCP_EMBEDDING_MODEL": "nomic-embed-text",
        "RAG_MCP_MEMORY_BACKEND": "openviking",
        "RAG_MCP_OPENVIKING_ACCOUNT": "default",
        "RAG_MCP_OPENVIKING_USER": "default",
        "RAG_MCP_OPENVIKING_AGENT_ID": "rag-mcp-server",
        "RAG_MCP_OPENVIKING_API_KEY": "${OPENVIKING_API_KEY}",
        "NO_PROXY": "${OKPNOPROXY}",
        "no_proxy": "${OKPNOPROXY}"
      }
    },
    "rag-knowledge-wiki": {
      "command": "rag-mcp-server",
      "env": {
        "RAG_MCP_SERVER_NAME": "rag-knowledge-wiki",
        "RAG_MCP_BACKEND": "confluence",
        "RAG_MCP_TIERED_RETRIEVAL": "false",
        "RAG_MCP_SUMMARIZER_URL": "http://127.0.0.1:11434",
        "RAG_MCP_SUMMARIZER_MODEL": "qwen2.5:7b",
        "RAG_MCP_SUMMARIZER_TIMEOUT": "180",
        "RAG_MCP_PNG_WRAP": "false",
        "RAG_MCP_PNG_MAX_PAGES": "${RAG_MCP_PNG_MAX_PAGES}",
        "RAG_MCP_PNG_MAX_CHARS_PER_STORE": "${RAG_MCP_PNG_MAX_CHARS_PER_STORE}",
        "RAG_MCP_CONFLUENCE_URL": "${CONFLUENCEURL}",
        "RAG_MCP_CONFLUENCE_EMAIL": "${CONFLUENCEEMAIL}",
        "RAG_MCP_CONFLUENCE_TOKEN": "${CONFLUENCETOKEN}",
        "RAG_MCP_CONFLUENCE_SPACE": "${CONFLUENCESPACE}"
      }
    },
    "rag-knowledge-okp": {
      "command": "rag-mcp-server",
      "env": {
        "RAG_MCP_SERVER_NAME": "rag-knowledge-okp",
        "RAG_MCP_BACKEND": "solr",
        "RAG_MCP_TIERED_RETRIEVAL": "false",
        "RAG_MCP_SUMMARIZER_URL": "http://127.0.0.1:11434",
        "RAG_MCP_SUMMARIZER_MODEL": "qwen2.5:7b",
        "RAG_MCP_SUMMARIZER_TIMEOUT": "180",
        "RAG_MCP_PNG_WRAP": "true",
        "RAG_MCP_PNG_MAX_PAGES": "${RAG_MCP_PNG_MAX_PAGES}",
        "RAG_MCP_PNG_MAX_CHARS_PER_STORE": "${RAG_MCP_PNG_MAX_CHARS_PER_STORE}",
        "RAG_MCP_EMBEDDING_MODEL": "nomic-embed-text",
        "RAG_MCP_SOLR_SEARCH_MODE": "hybrid",
        "RAG_MCP_SOLR_URL": "${OKPSOLRURL}",
        "SSL_CERT_FILE": "/etc/pki/tls/certs/ca-bundle.crt",
        "SSL_CERT_FILE_ALT": "${OKPSSLCERTFILE}",
        "NO_PROXY": "${OKPNOPROXY}",
        "no_proxy": "${OKPNOPROXY}"
      }
    }
  }
}
